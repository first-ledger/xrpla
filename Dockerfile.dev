ARG UBUNTU_VERSION=24.04
FROM ubuntu:${UBUNTU_VERSION}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates cmake ninja-build g++-12 libcurl4-openssl-dev libsodium-dev \
    nlohmann-json3-dev libtomlplusplus-dev libgtest-dev libzstd-dev pkg-config python3 \
    && rm -rf /var/lib/apt/lists/*
ENV CC=gcc-12 CXX=g++-12
WORKDIR /src
COPY . .
RUN cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug \
    -DXRPLA_WITH_LIBXRPL=OFF -DXRPLA_SYSTEM_DEPS=ON \
    && cmake --build build -j 2 && ctest --test-dir build --output-on-failure
ENTRYPOINT ["/src/build/xrpla"]
